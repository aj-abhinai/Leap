# Local development values. Copy to .env for `docker compose` and edit as needed.
# Placeholder/empty secrets are rejected in every environment; the committed dev
# JWT secret below is accepted only in development. Production must set a strong
# JWT_SECRET and SUPERADMIN_*.

DB_PASSWORD=crm
APP_ENV=development
JWT_SECRET=dev-only-jwt-secret-0123456789abcdef
SUPERADMIN_EMAIL=admin@admin.com
SUPERADMIN_PASSWORD=admin

# Optional overrides (also available to the Go binary directly):
# APP_PORT, DB_HOST, DB_PORT, DB_USER, DB_NAME, DB_SSLMODE, JWT_ISSUER,
# COOKIE_SECURE (true when serving over HTTPS)
