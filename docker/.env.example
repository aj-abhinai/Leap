# Production values for `docker compose up` (compose reads this file from
# docker/). Copy it to docker/.env and fill in real secrets:
#
#   cp docker/.env.example docker/.env
#
# The application refuses to start until JWT_SECRET / SUPERADMIN_EMAIL /
# SUPERADMIN_PASSWORD are provided — placeholders and the committed dev
# values fail validation immediately (before the HTTP listener opens).
#
# Development does NOT use this file. The dev stack runs with the committed
# config.dev.toml via the compose override:
#
#   just docker-up
#   # => docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up -d

APP_ENV=production

# Required — the app exits at startup while these are empty/placeholder.
JWT_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Required — the app and the bundled Postgres both refuse to start on an
# empty/development database password. Use the same value for both.
POSTGRES_PASSWORD=
DB_PASSWORD=

# Optional overrides:
# APP_PORT, DB_HOST, DB_PORT, DB_USER, DB_NAME, DB_SSLMODE,
# TRUSTED_PROXIES, JWT_ISSUER